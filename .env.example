# Copy this file to ".env" and adjust the values you need.
# ".env" is git-ignored, so credentials never end up in the repository.

# ---------------------------------------------------------------------------
# Runtime mode
# true  -> local stack: folder lake + DuckDB warehouse (no cloud account)
# false -> original stack: Amazon S3 + Snowflake
# ---------------------------------------------------------------------------
USE_LOCAL=true

# ---------------------------------------------------------------------------
# Local stack (USE_LOCAL=true)
# ---------------------------------------------------------------------------
# LOCAL_LAKE_DIR=lake
# LOCAL_WAREHOUSE_PATH=warehouse/retail_sales.duckdb
# SPARK_DRIVER_MEMORY=4g

# ---------------------------------------------------------------------------
# Amazon S3 (USE_LOCAL=false)
# ---------------------------------------------------------------------------
# AWS_S3_BUCKET_NAME=retailsalesetl
# AWS_ACCESS_KEY=...
# AWS_SECRET_KEY=...
# AWS_REGION=us-east-1
# Optional, for MinIO / LocalStack: AWS_ENDPOINT_URL=http://localhost:9000

# ---------------------------------------------------------------------------
# Snowflake (USE_LOCAL=false)
# ---------------------------------------------------------------------------
# SNOWFLAKE_USER=...
# SNOWFLAKE_PASSWORD=...
# SNOWFLAKE_ACCOUNT=abc12345.eu-central-1
# SNOWFLAKE_WAREHOUSE=RETAIL_SALES_WH
# SNOWFLAKE_DATABASE=RETAIL_SALES_DB
# SNOWFLAKE_SCHEMA=RETAIL_SALES_DATA_SCHEMA
